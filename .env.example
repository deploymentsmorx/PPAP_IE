ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_API_KEY_HERE
PPAP_ANTHROPIC_MODEL=claude-opus-5
PPAP_REPORT_ANTHROPIC_MODEL=claude-opus-5
PPAP_TAGGING_ANTHROPIC_MODEL=claude-opus-5
PPAP_TAGGING_ANTHROPIC_FALLBACK=1
PPAP_VALIDATION_RULE_BATCH_SIZE=9
PPAP_VALIDATION_SCHEMA_RETRY_RULE_BATCH_SIZE=9
PPAP_SUPER_ADMIN_USER=superadmin
PPAP_SUPER_ADMIN_PASSWORD=SuperAdmin@123
PPAP_FULL_ACCESS_USER=fullaccess
PPAP_FULL_ACCESS_PASSWORD=FullAccess@123
PPAP_CREATOR_USER=creator
PPAP_CREATOR_PASSWORD=Creator@123
PPAP_QUALITY_USER=quality
PPAP_QUALITY_PASSWORD=Quality@123

# Neon Postgres (required for production). Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# S3 for all PPAP case files under s3://ieppcostsheeterp/PPAP/
S3_BUCKET=ieppcostsheeterp
S3_PREFIX=PPAP/
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=PASTE_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PASTE_AWS_SECRET_ACCESS_KEY
# S3_ENABLED=1
